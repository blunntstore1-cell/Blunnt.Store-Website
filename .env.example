# Add these in Vercel: Project Settings → Environment Variables.
# Do not commit a real .env file or expose RAZORPAY_KEY_SECRET in browser code.
RAZORPAY_KEY_ID=rzp_test_your_public_key_id
RAZORPAY_KEY_SECRET=your_test_or_live_key_secret
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_public_storefront_access_token
SHOPIFY_STOREFRONT_API_VERSION=2026-04
